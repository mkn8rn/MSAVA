# Copying an active .env file into source control is forbidden. This template
# is copied to the assembly-local Environment directory by Supprocom.Secrets
# and creates .env on first production startup when the active file is missing.

jwt_issuer_signing_key=replace-with-at-least-32-characters-of-secret-material
jwt_issuer_name=MSAVA
jwt_issuer_audience=MSAVA

admin_username=admin
admin_password=replace-with-production-admin-password

postgres_basedb_user=postgres
postgres_basedb_password=replace-with-postgres-password
postgres_basedb_host=localhost
postgres_basedb_port=5432
postgres_basedb_dbname=msava
postgres_basedb_ssl_mode=Disable

serilog_information_level=Information
serilog_rolling_interval=Day
serilog_retained_file_count_limit=31
serilog_file_size_limit_bytes=10485760
serilog_roll_on_file_size_limit=true
